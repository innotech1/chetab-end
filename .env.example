# Copy this file to .env and fill in your own values. Never commit .env itself.

# MongoDB Atlas connection string — from your Atlas cluster's "Connect" button
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/cheta?retryWrites=true&w=majority

# Any long random string — used to sign login tokens. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string

# Port the API server listens on
PORT=5000
